# Copy to .env.local and fill in. Both values are public by design (they ship in the
# browser bundle); access is controlled by Row Level Security in the database.
# Find them in Supabase: Project Settings -> API Keys / Data API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never add a secret or service-role key here: this is a static site with no server,
# so anything in the environment at build time can end up in public JavaScript.

# Optional. Cloudflare Turnstile site key (public). When set, the email sign-in form shows
# a human check and passes its token to Supabase. Set it, deploy, and only then switch on
# CAPTCHA protection in Supabase with the matching secret key (see docs/deployment.md).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
